rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { 
      return request.auth != null; 
    }

    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'dawood.mehmood945@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Validator
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'borrowedCount'])
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.role in ['admin', 'member']
        && data.borrowedCount is number && data.borrowedCount >= 0 && data.borrowedCount <= 5;
    }

    // Book Validator
    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author', 'totalInventory', 'availableInventory'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.author is string && data.author.size() > 0 && data.author.size() <= 150
        && data.totalInventory is number && data.totalInventory >= 0
        && data.availableInventory is number && data.availableInventory >= 0 && data.availableInventory <= data.totalInventory;
    }

    // Borrow Validator
    function isValidBorrow(data) {
      return data.keys().hasAll(['userId', 'bookId', 'borrowedAt', 'dueDate', 'status', 'bookTitle'])
        && data.userId is string && data.userId.size() <= 128
        && data.bookId is string && data.bookId.size() <= 128
        && data.bookTitle is string && data.bookTitle.size() <= 200
        && data.borrowedAt is timestamp
        && data.dueDate is timestamp
        && data.status in ['active', 'returned', 'overdue']
        && (data.status != 'returned' || data.keys().hasAll(['returnedAt']));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().borrowedCount == 0
        && (incoming().role == 'member' || isAdmin());

      allow update: if isSignedIn() && isValidUser(incoming()) && isValidId(userId) && (
        (isAdmin()) || 
        (
          request.auth.uid == userId 
          && incoming().role == existing().role
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt', 'borrowedCount'])
          && incoming().borrowedCount >= 0
          && incoming().borrowedCount <= 5
        )
      );
    }

    match /books/{bookId} {
      allow list: if true;
      allow get: if isValidId(bookId);
      
      allow create: if isAdmin() && isValidBook(incoming());
      allow update: if isValidBook(incoming()) && isValidId(bookId) && (
        // Admin full update
        (isAdmin()) ||
        // Member borrowing/returning (only updating availableInventory)
        (
          isSignedIn() 
          && incoming().diff(existing()).affectedKeys().hasOnly(['availableInventory'])
          && incoming().availableInventory >= 0
          && incoming().availableInventory <= existing().totalInventory
          && (
            incoming().availableInventory == existing().availableInventory - 1 || 
            incoming().availableInventory == existing().availableInventory + 1
          )
        )
      );
      allow delete: if isAdmin() && isValidId(bookId);
    }

    match /borrows/{borrowId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && isValidId(borrowId) && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Allow create borrow if user borrowing limit is respected
      // Needs atomicity: the user MUST exist and book available.
      // But rules can't increment, only check logic. So we rely on the application to run a batch.
      allow create: if isSignedIn() && isValidBorrow(incoming()) 
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && exists(/databases/$(database)/documents/books/$(incoming().bookId));
        // Note: For full atomicity we'd use existsAfter or getAfter on user & book to verify counters

      allow update: if isSignedIn() && isValidBorrow(incoming()) && isValidId(borrowId) && (
        (isAdmin()) ||
        (
          incoming().userId == request.auth.uid 
          && existing().userId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'returnedAt'])
          && incoming().status == 'returned'
        )
      );
    }
  }
}
